{
  "name": "lightning-box",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build-tsgo": "tsgo -p tsconfig.json",
    "postbuild": "cp src/proto.js dist",
    "start": "rm -rf dist && npm run build && node dist/src/server.js",
    "watch": "concurrently \"tsc -p tsconfig.json -w\" \"nodemon -w dist dist/server.js\"",
    "proto": "pbjs --force-long -t static-module -o src/proto.js proto/lightning.proto proto/router.proto && pbts -o src/proto.d.ts src/proto.js",
    "test": "jest tests",
    "test:coverage": "jest --coverage --coveragePathIgnorePatterns \"proto\\.js|mocks\" tests"
  },
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.17.0"
  },
  "author": "Hampus Sjöberg",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "bech32": "2.0.0",
    "fastify": "^5.11.2",
    "long": "^5.3.2",
    "protobufjs": "^8.7.1",
    "sqlite": "^4.2.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.0",
    "@typescript/native-preview": "^7.0.0-dev.20251202.1",
    "concurrently": "^10.0.4",
    "jest": "^29.7.0",
    "protobufjs-cli": "^2.6.1",
    "stream-mock": "^2.0.5",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  }
}
